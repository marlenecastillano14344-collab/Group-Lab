import heapq

numbers = [10, 20, 15, 30]

heapq.heapify(numbers)
print("Initial heap:", numbers)

heapq.heappush(numbers, 5)
print("After inserting 5:", numbers)

print("Minimum element (peek):", numbers[0])

extracted = heapq.heappop(numbers)
print("Extracted value:", extracted)
print("Heap after extraction:", numbers)

